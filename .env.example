# Runtime
NODE_ENV=development
PORT=3000

# Add credentials only when implementing the corresponding official OAuth adapter.
# Never commit real secrets.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

META_APP_ID=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Publishing safety: keep manual approval enabled by default.
REQUIRE_PUBLISH_APPROVAL=true

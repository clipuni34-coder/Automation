# Runtime
NODE_ENV=development
PORT=3000

# Discovery
# YouTube Data API key (create a key in Google Cloud and enable YouTube Data API v3).
YOUTUBE_DATA_API_KEY=
DISCOVERY_REGIONS=US,GB,CA,AU,IN,NG,ZA,BR,MX,DE,JP,KR
DISCOVERY_CATEGORIES=1,2,10,15,17,19,20,22,23,24,25,26,27,28,29
# Optional YouTube search terms, separated by |. Search API consumes more quota than mostPopular charts.
DISCOVERY_SEARCH_QUERIES=
DISCOVERY_SEARCH_MAX_RESULTS=20
DISCOVERY_SEARCH_ORDER=viewCount
DISCOVERY_SEARCH_REGION=US
# Comma-separated public RSS/Atom feed URLs. Use feeds you are permitted to access.
RSS_FEEDS=
DISCOVERY_STORE_PATH=data/discovery.json

# Topic research (Tavily Search API)
TAVILY_API_KEY=

# Rights-cleared live-action video search (Pixabay API).
PIXABAY_API_KEY=

# AI creative reasoning (Gemini primary, OpenAI fallback). Store real keys as GitHub Actions secrets.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Potentially billable cloud providers are disabled unless explicitly enabled.
ENABLE_GEMINI_CREATIVE=false
ENABLE_OPENAI_CREATIVE=false
ENABLE_GEMINI_TTS=false
ENABLE_GEMINI_IMAGE_GENERATION=false
ENABLE_OPENAI_VISION_QC=false
ENABLE_GEMINI_EVIDENCE_ASSESSMENT=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
CREATIVE_LANGUAGE=English

# Local, quota-free Kokoro-82M CPU TTS fallback (model files downloaded by production workflow).
KOKORO_MODEL_PATH=models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/kokoro/voices-v1.0.bin
KOKORO_VOICE=af_heart

# Add credentials only when implementing the corresponding official OAuth adapter.
# Never commit real secrets.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_EXPECTED_CHANNEL_ID=
YOUTUBE_REDIRECT_URI=

META_APP_ID=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Publishing safety: disabled until OAuth is configured and a package has passed all gates.
REQUIRE_PUBLISH_APPROVAL=true
YOUTUBE_AUTO_PUBLISH=false
YOUTUBE_ALLOW_PUBLIC_PUBLISH=false
YOUTUBE_PUBLISH_PRIVACY=private
YOUTUBE_CATEGORY_ID=22
